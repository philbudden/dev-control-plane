#!/usr/bin/env bash
set -euo pipefail

if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${DEVCONTAINER:-}" ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
    echo "dcauth is a host control-plane command. Run it from the host, not inside a devcontainer."
    exit 1
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: dcauth <workspace-name>"
    exit 2
fi

check_command() {
    command -v "$1" >/dev/null 2>&1
}

token_type() {
    case "$1" in
        github_pat_*) printf "fine-grained-pat" ;;
        gho_*) printf "oauth" ;;
        ghu_*) printf "github-app-user" ;;
        ghp_*) printf "classic-pat" ;;
        "") printf "missing" ;;
        *) printf "unknown" ;;
    esac
}

is_copilot_token_supported() {
    case "$1" in
        github_pat_*|gho_*|ghu_*) return 0 ;;
        *) return 1 ;;
    esac
}

if ! command -v devpod >/dev/null 2>&1; then
    echo "DevPod CLI is required but was not found on PATH."
    exit 1
fi

name="$1"
agent_forwarding="${DCAUTH_AGENT_FORWARDING:-true}"
send_env=(--send-env GH_PROMPT_DISABLED)
github_token=""
host_copilot_token="${COPILOT_GITHUB_TOKEN:-}"
forward_classic_gh_token="${DCSSH_FORWARD_CLASSIC_GH_TOKEN:-false}"

set +e

section() {
    printf "\n== %s ==\n" "$1"
}

section "Host preflight"
printf "USER=%s\n" "${USER:-unknown}"
printf "PWD=%s\n" "$PWD"
if [ -n "${SSH_AUTH_SOCK:-}" ]; then
    printf "SSH_AUTH_SOCK=%s\n" "$SSH_AUTH_SOCK"
else
    printf "SSH_AUTH_SOCK=missing\n"
fi

if check_command ssh-add; then
    ssh-add -l 2>&1
    printf "host_ssh_add_exit=%s\n" "$?"
else
    printf "ssh-add=missing\n"
fi

if check_command ssh; then
    ssh -o BatchMode=yes -T git@github.com 2>&1
    printf "host_ssh_github_exit=%s\n" "$?"
else
    printf "ssh=missing\n"
fi

if check_command gh; then
    section "Host GitHub CLI"
    gh --version | head -n 1
    gh auth status 2>&1
    printf "host_gh_auth_status_exit=%s\n" "$?"
    if github_token="$(gh auth token 2>/dev/null)" && [ -n "$github_token" ]; then
        printf "host_gh_token=available\n"
        printf "host_gh_token_type=%s\n" "$(token_type "$github_token")"
        if is_copilot_token_supported "$github_token"; then
            printf "host_gh_token_copilot_supported=yes\n"
            printf "host_gh_token_forwarded_as_GH_TOKEN=yes\n"
        else
            printf "host_gh_token_copilot_supported=no\n"
            if [ "$forward_classic_gh_token" = "true" ]; then
                printf "host_gh_token_forwarded_as_GH_TOKEN=yes; DCSSH_FORWARD_CLASSIC_GH_TOKEN=true\n"
            else
                printf "host_gh_token_forwarded_as_GH_TOKEN=no; classic PAT would be read by Copilot CLI as GH_TOKEN\n"
            fi
        fi
    else
        printf "host_gh_token=missing\n"
    fi
else
    printf "gh=missing\n"
fi

set -e

if [ -n "$github_token" ]; then
    if is_copilot_token_supported "$github_token"; then
        export GH_TOKEN="$github_token"
        send_env+=(--send-env GH_TOKEN)
    elif [ "$forward_classic_gh_token" = "true" ]; then
        export GH_TOKEN="$github_token"
        send_env+=(--send-env GH_TOKEN)
    fi
fi

if is_copilot_token_supported "$host_copilot_token"; then
    export COPILOT_GITHUB_TOKEN="$host_copilot_token"
    send_env+=(--send-env COPILOT_GITHUB_TOKEN)
elif is_copilot_token_supported "$github_token"; then
    export COPILOT_GITHUB_TOKEN="$github_token"
    send_env+=(--send-env COPILOT_GITHUB_TOKEN)
fi

export GH_PROMPT_DISABLED=1

remote_script=""
read -r -d '' remote_script <<'AUTH_CHECK' || true
set +e

section() {
    printf "\n== %s ==\n" "$1"
}

check_command() {
    command -v "$1" >/dev/null 2>&1
}

token_type() {
    case "$1" in
        github_pat_*) printf "fine-grained-pat" ;;
        gho_*) printf "oauth" ;;
        ghu_*) printf "github-app-user" ;;
        ghp_*) printf "classic-pat" ;;
        "") printf "missing" ;;
        *) printf "unknown" ;;
    esac
}

is_copilot_token_supported() {
    case "$1" in
        github_pat_*|gho_*|ghu_*) return 0 ;;
        *) return 1 ;;
    esac
}

load_brew() {
    if check_command brew; then
        return 0
    fi

    if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
        return 0
    fi

    if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
        return 0
    fi

    return 1
}

load_brew >/dev/null 2>&1 || true

redact_url() {
    printf "%s" "$1" | sed -E 's#(https?://)[^/@]+(:[^/@]+)?@#\1***@#'
}

section "Environment"
printf "USER=%s\n" "${USER:-unknown}"
printf "PWD=%s\n" "$PWD"
printf "SHELL=%s\n" "${SHELL:-unknown}"
if [ -n "${SSH_AUTH_SOCK:-}" ]; then
    printf "SSH_AUTH_SOCK=%s\n" "$SSH_AUTH_SOCK"
else
    printf "SSH_AUTH_SOCK=missing\n"
fi

section "Git"
if check_command git; then
    git --version
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf "Repository: %s\n" "$(basename "$(git rev-parse --show-toplevel)")"
        for remote in $(git remote); do
            url="$(git remote get-url "$remote" 2>/dev/null || true)"
            if [ -n "$url" ]; then
                printf "%s %s\n" "$remote" "$(redact_url "$url")"
            fi
        done
        git fetch --dry-run 2>&1
        printf "git_fetch_dry_run_exit=%s\n" "$?"
    else
        printf "Not inside a Git work tree.\n"
    fi
else
    printf "git=missing\n"
fi

section "SSH agent"
if check_command ssh-add; then
    ssh-add -l 2>&1
    printf "ssh_add_exit=%s\n" "$?"
else
    printf "ssh-add=missing\n"
fi

section "Workspace GitHub CLI"
printf "workspace_gh_auth_model=host-owned token bridge; do not run gh auth login in the workspace\n"
if check_command gh; then
    gh --version | head -n 1
    if [ -n "${GH_TOKEN:-}" ]; then
        printf "GH_TOKEN=available\n"
        printf "GH_TOKEN_type=%s\n" "$(token_type "$GH_TOKEN")"
    else
        printf "GH_TOKEN=missing\n"
    fi
    gh auth status 2>&1
    printf "gh_auth_status_exit=%s\n" "$?"
else
    printf "gh=missing\n"
fi

section "GitHub Copilot CLI"
if check_command copilot; then
    copilot --version 2>&1
    printf "copilot_exit=%s\n" "$?"
    if [ -n "${COPILOT_GITHUB_TOKEN:-}" ]; then
        printf "COPILOT_GITHUB_TOKEN=available\n"
        printf "COPILOT_GITHUB_TOKEN_type=%s\n" "$(token_type "$COPILOT_GITHUB_TOKEN")"
        if is_copilot_token_supported "$COPILOT_GITHUB_TOKEN"; then
            printf "COPILOT_GITHUB_TOKEN_supported=yes\n"
        else
            printf "COPILOT_GITHUB_TOKEN_supported=no\n"
        fi
    else
        printf "COPILOT_GITHUB_TOKEN=missing\n"
        if [ -n "${GH_TOKEN:-}" ]; then
            printf "copilot_auth_warning=GH_TOKEN is %s; Copilot CLI will reject it if used as fallback\n" "$(token_type "$GH_TOKEN")"
        fi
    fi
else
    printf "copilot=missing\n"
fi

section "CodeRabbit CLI"
if check_command cr; then
    cr --version 2>&1
    printf "cr_version_exit=%s\n" "$?"
else
    printf "cr=missing\n"
fi

exit 0
AUTH_CHECK

devpod ssh --silent --agent-forwarding="$agent_forwarding" "${send_env[@]}" "$name" --command "$remote_script"
