#!/usr/bin/env bash
set -euo pipefail

if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${DEVCONTAINER:-}" ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
    echo "dcauth is a host control-plane command. Run it from the host, not inside a devcontainer."
    exit 1
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: dcauth <workspace-name>"
    exit 2
fi

check_command() {
    command -v "$1" >/dev/null 2>&1
}

if ! command -v devpod >/dev/null 2>&1; then
    echo "DevPod CLI is required but was not found on PATH."
    exit 1
fi

name="$1"
agent_forwarding="${DCAUTH_AGENT_FORWARDING:-true}"
send_env=(--send-env GH_PROMPT_DISABLED)
github_token=""

set +e

section() {
    printf "\n== %s ==\n" "$1"
}

section "Host preflight"
printf "USER=%s\n" "${USER:-unknown}"
printf "PWD=%s\n" "$PWD"
if [ -n "${SSH_AUTH_SOCK:-}" ]; then
    printf "SSH_AUTH_SOCK=%s\n" "$SSH_AUTH_SOCK"
else
    printf "SSH_AUTH_SOCK=missing\n"
fi

if check_command ssh-add; then
    ssh-add -l 2>&1
    printf "host_ssh_add_exit=%s\n" "$?"
else
    printf "ssh-add=missing\n"
fi

if check_command ssh; then
    ssh -o BatchMode=yes -T git@github.com 2>&1
    printf "host_ssh_github_exit=%s\n" "$?"
else
    printf "ssh=missing\n"
fi

if check_command gh; then
    section "Host GitHub CLI"
    gh --version | head -n 1
    gh auth status 2>&1
    printf "host_gh_auth_status_exit=%s\n" "$?"
    if github_token="$(gh auth token 2>/dev/null)" && [ -n "$github_token" ]; then
        printf "host_gh_token=available\n"
    else
        printf "host_gh_token=missing\n"
    fi
else
    printf "gh=missing\n"
fi

set -e

if [ -n "$github_token" ]; then
    export GH_TOKEN="$github_token"
    export COPILOT_GITHUB_TOKEN="$github_token"
    send_env+=(--send-env GH_TOKEN --send-env COPILOT_GITHUB_TOKEN)
fi

export GH_PROMPT_DISABLED=1

remote_script="$(cat <<'AUTH_CHECK'
set +e

section() {
    printf "\n== %s ==\n" "$1"
}

check_command() {
    command -v "$1" >/dev/null 2>&1
}

load_brew() {
    if check_command brew; then
        return 0
    fi

    if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
        return 0
    fi

    if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
        return 0
    fi

    return 1
}

load_brew >/dev/null 2>&1 || true

redact_url() {
    printf "%s" "$1" | sed -E 's#(https?://)[^/@]+(:[^/@]+)?@#\1***@#'
}

section "Environment"
printf "USER=%s\n" "${USER:-unknown}"
printf "PWD=%s\n" "$PWD"
printf "SHELL=%s\n" "${SHELL:-unknown}"
if [ -n "${SSH_AUTH_SOCK:-}" ]; then
    printf "SSH_AUTH_SOCK=%s\n" "$SSH_AUTH_SOCK"
else
    printf "SSH_AUTH_SOCK=missing\n"
fi

section "Git"
if check_command git; then
    git --version
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf "Repository: %s\n" "$(basename "$(git rev-parse --show-toplevel)")"
        for remote in $(git remote); do
            url="$(git remote get-url "$remote" 2>/dev/null || true)"
            if [ -n "$url" ]; then
                printf "%s %s\n" "$remote" "$(redact_url "$url")"
            fi
        done
        git fetch --dry-run 2>&1
        printf "git_fetch_dry_run_exit=%s\n" "$?"
    else
        printf "Not inside a Git work tree.\n"
    fi
else
    printf "git=missing\n"
fi

section "SSH agent"
if check_command ssh-add; then
    ssh-add -l 2>&1
    printf "ssh_add_exit=%s\n" "$?"
else
    printf "ssh-add=missing\n"
fi

section "Workspace GitHub CLI"
printf "workspace_gh_auth_model=host-owned token bridge; do not run gh auth login in the workspace\n"
if check_command gh; then
    gh --version | head -n 1
    if [ -n "${GH_TOKEN:-}" ]; then
        printf "GH_TOKEN=available\n"
    else
        printf "GH_TOKEN=missing\n"
    fi
    gh auth status 2>&1
    printf "gh_auth_status_exit=%s\n" "$?"
else
    printf "gh=missing\n"
fi

section "GitHub Copilot CLI"
if check_command copilot; then
    copilot --version 2>&1
    printf "copilot_exit=%s\n" "$?"
    if [ -n "${COPILOT_GITHUB_TOKEN:-}" ]; then
        printf "COPILOT_GITHUB_TOKEN=available\n"
    else
        printf "COPILOT_GITHUB_TOKEN=missing\n"
    fi
else
    printf "copilot=missing\n"
fi

section "CodeRabbit CLI"
if check_command cr; then
    cr --version 2>&1
    printf "cr_version_exit=%s\n" "$?"
else
    printf "cr=missing\n"
fi

exit 0
AUTH_CHECK
)"

devpod ssh --silent --agent-forwarding="$agent_forwarding" "${send_env[@]}" "$name" --command "$remote_script"
