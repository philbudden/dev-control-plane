#!/usr/bin/env bash
set -euo pipefail

if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${DEVCONTAINER:-}" ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
    echo "dcr is a host control-plane command. Run it from the host, not inside a devcontainer."
    exit 1
fi

if ! command -v devpod >/dev/null 2>&1; then
    echo "DevPod CLI is required but was not found on PATH."
    exit 1
fi

name="${1:-$(basename "$PWD")}"

devpod up "$name" --recreate --ide none
