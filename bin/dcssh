#!/usr/bin/env bash
set -euo pipefail

if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${DEVCONTAINER:-}" ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
    echo "dcssh is a host control-plane command. Run it from the host, not inside a devcontainer."
    exit 1
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: dcssh <workspace-name> [devpod ssh options]"
    exit 2
fi

if ! command -v devpod >/dev/null 2>&1; then
    echo "DevPod CLI is required but was not found on PATH."
    exit 1
fi

name="$1"
shift

send_env=(--send-env GH_PROMPT_DISABLED)
github_token=""
host_copilot_token="${COPILOT_GITHUB_TOKEN:-}"
forward_classic_gh_token="${DCSSH_FORWARD_CLASSIC_GH_TOKEN:-false}"
auth_debug="${DCSSH_AUTH_DEBUG:-false}"

token_type() {
    case "$1" in
        github_pat_*) printf "fine-grained-pat" ;;
        gho_*) printf "oauth" ;;
        ghu_*) printf "github-app-user" ;;
        ghp_*) printf "classic-pat" ;;
        "") printf "missing" ;;
        *) printf "unknown" ;;
    esac
}

is_copilot_token_supported() {
    case "$1" in
        github_pat_*|gho_*|ghu_*) return 0 ;;
        *) return 1 ;;
    esac
}

debug_auth() {
    if [ "$auth_debug" = "true" ]; then
        printf "%s\n" "$1" >&2
    fi
}

if command -v gh >/dev/null 2>&1; then
    if github_token="$(gh auth token 2>/dev/null)" && [ -n "$github_token" ]; then
        if is_copilot_token_supported "$github_token"; then
            export GH_TOKEN="$github_token"
            send_env+=(--send-env GH_TOKEN)
            debug_auth "Forwarding host GitHub CLI token as GH_TOKEN."
        elif [ "$forward_classic_gh_token" = "true" ]; then
            export GH_TOKEN="$github_token"
            send_env+=(--send-env GH_TOKEN)
            echo "Forwarding classic GH_TOKEN by request; Copilot CLI will reject it if no supported Copilot token is present." >&2
        else
            debug_auth "Host GitHub CLI token is $(token_type "$github_token"); not forwarding it because Copilot CLI also reads GH_TOKEN."
        fi
    else
        debug_auth "Host GitHub CLI is not authenticated; token auth will not be bridged into the workspace."
    fi
else
    debug_auth "Host GitHub CLI is missing; token auth will not be bridged into the workspace."
fi

if is_copilot_token_supported "$host_copilot_token"; then
    export COPILOT_GITHUB_TOKEN="$host_copilot_token"
    send_env+=(--send-env COPILOT_GITHUB_TOKEN)
    debug_auth "Forwarding host COPILOT_GITHUB_TOKEN."
elif is_copilot_token_supported "$github_token"; then
    export COPILOT_GITHUB_TOKEN="$github_token"
    send_env+=(--send-env COPILOT_GITHUB_TOKEN)
    debug_auth "Forwarding host GitHub CLI token as COPILOT_GITHUB_TOKEN."
elif [ -n "$github_token" ]; then
    debug_auth "Host GitHub CLI token is $(token_type "$github_token"); Copilot CLI requires an OAuth, GitHub App user, or fine-grained PAT token."
elif [ -n "$host_copilot_token" ]; then
    debug_auth "Host COPILOT_GITHUB_TOKEN is $(token_type "$host_copilot_token"); not forwarding it because Copilot CLI rejects that token type."
fi

export GH_PROMPT_DISABLED=1

exec devpod ssh --silent --agent-forwarding=true "${send_env[@]}" "$name" "$@"
