#!/usr/bin/env bash
set -euo pipefail

if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${DEVCONTAINER:-}" ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
    echo "dca is a host control-plane command. Run it from the host, not inside a devcontainer."
    exit 1
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: dca <workspace-name>"
    exit 2
fi

if ! command -v devpod >/dev/null 2>&1; then
    echo "DevPod CLI is required but was not found on PATH."
    exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is required but was not found on PATH."
    exit 1
fi

control_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
name="$1"
attach_cmd="${control_bin_dir}/dcssh $name"
session_runtime_dir="${TMPDIR:-/tmp}/dev-control-plane-${USER:-user}"
mkdir -p "$session_runtime_dir"

ai_script="${session_runtime_dir}/${name}-ai.sh"
review_script="${session_runtime_dir}/${name}-review.sh"
workspace_path_setup='if [ -f "$HOME/.config/shell/env.sh" ]; then . "$HOME/.config/shell/env.sh"; fi; if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"; fi; PATH="$HOME/.local/bin:$HOME/bin:$PATH"; export PATH;'
ai_remote_command="${workspace_path_setup} if command -v copilot >/dev/null 2>&1; then exec copilot; else echo \"GitHub Copilot CLI is not installed in this workspace.\"; exec \"\${SHELL:-/bin/sh}\"; fi"
review_remote_command="${workspace_path_setup} if command -v cr >/dev/null 2>&1; then exec cr --interactive; elif command -v coderabbit >/dev/null 2>&1; then exec coderabbit --interactive; else echo \"CodeRabbit CLI is not installed in this workspace.\"; exec \"\${SHELL:-/bin/sh}\"; fi"

{
    printf '#!/usr/bin/env bash\n'
    printf 'exec %q %q --command %q\n' "${control_bin_dir}/dcssh" "$name" "$ai_remote_command"
} >"$ai_script"

{
    printf '#!/usr/bin/env bash\n'
    printf 'exec %q %q --command %q\n' "${control_bin_dir}/dcssh" "$name" "$review_remote_command"
} >"$review_script"

chmod +x "$ai_script" "$review_script"

if tmux has-session -t "$name" 2>/dev/null; then
    tmux set-option -t "$name" -q @dev_control_workspace "$name"
    if [ -n "${TMUX:-}" ]; then
        exec tmux switch-client -t "$name"
    fi
    exec tmux attach-session -t "$name"
fi

tmux new-session -d -s "$name" -n edit "$attach_cmd"
tmux new-window -t "$name:" -n shell "$attach_cmd"
tmux new-window -t "$name:" -n git "$attach_cmd"
tmux new-window -t "$name:" -n docker
tmux new-window -t "$name:" -n ai "$ai_script"
tmux new-window -t "$name:" -n review "$review_script"
tmux new-window -t "$name:" -n run "$attach_cmd"
tmux set-option -t "$name" -q @dev_control_workspace "$name"
tmux select-window -t "$name:1"

if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "$name"
fi

exec tmux attach-session -t "$name"
