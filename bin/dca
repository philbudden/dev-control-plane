#!/usr/bin/env bash
set -euo pipefail

if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${DEVCONTAINER:-}" ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
    echo "dca is a host control-plane command. Run it from the host, not inside a devcontainer."
    exit 1
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: dca <workspace-name>"
    exit 2
fi

if ! command -v devpod >/dev/null 2>&1; then
    echo "DevPod CLI is required but was not found on PATH."
    exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is required but was not found on PATH."
    exit 1
fi

control_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
name="$1"
session_runtime_dir="${TMPDIR:-/tmp}/dev-control-plane-${USER:-user}"
mkdir -p "$session_runtime_dir"

nvim_script="${session_runtime_dir}/${name}-nvim.sh"
workspace_path_setup='if [ -f "$HOME/.config/shell/env.sh" ]; then . "$HOME/.config/shell/env.sh"; fi; if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"; fi; PATH="$HOME/.local/bin:$HOME/bin:$PATH"; export PATH;'
nvim_remote_command="${workspace_path_setup} if command -v nvim >/dev/null 2>&1; then nvim .; status=\$?; printf \"\nNeovim exited with status %s. Leaving this workspace shell open.\n\" \"\$status\"; exec \"\${SHELL:-/bin/sh}\"; else echo \"Neovim is not installed in this workspace.\"; exec \"\${SHELL:-/bin/sh}\"; fi"

{
    printf '#!/usr/bin/env bash\n'
    printf 'exec %q %q --command %q\n' "${control_bin_dir}/dcssh" "$name" "$nvim_remote_command"
} >"$nvim_script"
chmod +x "$nvim_script"

if tmux has-session -t "$name" 2>/dev/null; then
    window_count="$(tmux list-windows -t "$name" 2>/dev/null | wc -l | tr -d '[:space:]')"
    if [ "${window_count:-0}" -gt 1 ]; then
        echo "tmux session '$name' already exists with $window_count windows."
        echo "dca now manages a single Neovim window and will not close existing windows automatically."
        echo "Detach, finish or remove the old session, then run: dca $name"
        exit 1
    fi

    tmux set-option -t "$name" -q @dev_control_workspace "$name"
    if [ -n "${TMUX:-}" ]; then
        exec tmux switch-client -t "$name"
    fi
    exec tmux attach-session -t "$name"
fi

tmux new-session -d -s "$name" -n nvim "$nvim_script"
tmux set-option -t "$name" -q @dev_control_workspace "$name"
tmux select-window -t "$name:1"

if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "$name"
fi

exec tmux attach-session -t "$name"
