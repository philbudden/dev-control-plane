#!/usr/bin/env bash
set -euo pipefail

if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${DEVCONTAINER:-}" ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
    echo "dcu is a host control-plane command. Run it from the host, not inside a devcontainer."
    exit 1
fi

if ! command -v devpod >/dev/null 2>&1; then
    echo "DevPod CLI is required but was not found on PATH."
    exit 1
fi

name="${1:-$(basename "$PWD")}"
dotfiles_enabled="${DCU_DOTFILES:-true}"
dotfiles_repo="${DCU_DOTFILES_REPO:-${DOTFILES_REPO:-https://github.com/philbudden/dotfiles.git}}"
dotfiles_script="${DCU_DOTFILES_SCRIPT:-bootstrap.sh}"

up_args=(up . --id "$name" --ide none)

if [ "$dotfiles_enabled" != "false" ] && [ "$dotfiles_enabled" != "0" ]; then
    up_args+=(--dotfiles "$dotfiles_repo" --dotfiles-script "$dotfiles_script")
fi

devpod "${up_args[@]}"
