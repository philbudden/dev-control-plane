{
  "name": "dev-control-plane-test",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "DEVCONTAINER": "true",
    "DEV_CONTROL_PLANE_TEST_CONTAINER": "true"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
